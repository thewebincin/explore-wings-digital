# Copy this file to .env and fill in the values. Never commit .env.

# --- Server ---------------------------------------------------------------
NODE_ENV=production
PORT=3000
# Public address of the site, no trailing slash. Used for canonical URLs,
# the sitemap, Open Graph tags and links inside emails.
SITE_URL=https://www.example.com
# Set to 1 when running behind Nginx / a load balancer (needed for secure
# cookies and correct visitor IPs). Leave empty for local development.
TRUST_PROXY=1

# Long random string (at least 32 characters). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# --- First owner account ---------------------------------------------------
# Used ONLY when the database has no users yet (first run). After that,
# change the password from Admin > Settings and you can remove these lines.
# If ADMIN_PASSWORD is empty, a random password is printed once in the log.
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=

# --- Email (enquiry notifications, auto-replies, alerts, weekly summary) ---
# Works with any SMTP provider (Zoho, Google Workspace, Brevo, Amazon SES...).
SMTP_HOST=
SMTP_PORT=587
# true for port 465, false for 587 (STARTTLS)
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# The "From" address, e.g. "Explore Wings <hello@yourdomain.in>"
SMTP_FROM=

# --- Optional ---------------------------------------------------------------
# Google Analytics 4 measurement ID (G-XXXXXXX). Can also be set in
# Admin > Settings. The built-in analytics work without it.
GA4_ID=
# Where the database, sessions, backups and private enquiry files live.
DATA_DIR=./data
# Where public uploads (logos, images) are stored. Served at /uploads.
UPLOADS_DIR=./public/uploads
# Set to 1 to switch off background jobs (uptime pings, daily backup,
# weekly email). Only useful for tests.
DISABLE_SCHEDULERS=
