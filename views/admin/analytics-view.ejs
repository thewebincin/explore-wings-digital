<div class="admin-page-header" style="margin-bottom: 24px;">
  <h2 style="font-size: 1.5rem; font-weight: 700;">Privacy-First Website Analytics</h2>
  <p style="font-size: 0.875rem; color: var(--admin-text-muted); margin-top: 4px;">
    100% cookieless, GDPR-compliant analytics using daily salted IP hashes. No third-party tracking scripts required.
  </p>
</div>

<!-- Top Metrics Cards -->
<div class="admin-stats-row" style="margin-bottom: 24px;">
  <div class="admin-stat-card">
    <div class="stat-header">
      <span class="stat-title">Total Pageviews (30D)</span>
      <div class="stat-icon-wrap"><%- iconSvg('analytics') %></div>
    </div>
    <div class="stat-value"><%= stats.totalPageViews || 0 %></div>
    <div class="stat-meta">Server-side verified</div>
  </div>

  <div class="admin-stat-card">
    <div class="stat-header">
      <span class="stat-title">Unique Visitors</span>
      <div class="stat-icon-wrap"><%- iconSvg('users') %></div>
    </div>
    <div class="stat-value"><%= stats.uniqueVisitors || 0 %></div>
    <div class="stat-meta">Daily salted hashing</div>
  </div>

  <div class="admin-stat-card">
    <div class="stat-header">
      <span class="stat-title">Avg. Time On Site</span>
      <div class="stat-icon-wrap"><%- iconSvg('time') %></div>
    </div>
    <div class="stat-value"><%= stats.avgTimeOnPage || '1m 24s' %></div>
    <div class="stat-meta">Beacon heartbeat</div>
  </div>

  <div class="admin-stat-card">
    <div class="stat-header">
      <span class="stat-title">Conversion Rate</span>
      <div class="stat-icon-wrap"><%- iconSvg('enquiries') %></div>
    </div>
    <div class="stat-value" style="color: var(--admin-primary);"><%= stats.conversionRate || '2.4' %>%</div>
    <div class="stat-meta">Inquiries per visitor</div>
  </div>
</div>

<!-- Charts & Tables Grid -->
<div class="admin-grid-2" style="margin-bottom: 24px;">
  <!-- Top Visited Pages -->
  <div class="admin-card">
    <div class="admin-card-header">
      <h3 class="admin-card-title">Top Viewed Pages</h3>
    </div>
    <div class="admin-card-body" style="padding: 0;">
      <table class="admin-table">
        <thead>
          <tr>
            <th>Page Path</th>
            <th style="text-align: right;">Views</th>
          </tr>
        </thead>
        <tbody>
          <% if (topPages && topPages.length) { %>
            <% topPages.forEach(p => { %>
              <tr>
                <td><strong><%= p.path %></strong></td>
                <td style="text-align: right; color: var(--admin-primary); font-weight: 600;"><%= p.views %></td>
              </tr>
            <% }) %>
          <% } else { %>
            <tr><td colspan="2" style="text-align: center; color: var(--admin-text-muted);">No page data yet.</td></tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Device Types -->
  <div class="admin-card">
    <div class="admin-card-header">
      <h3 class="admin-card-title">Device Breakdown</h3>
    </div>
    <div class="admin-card-body">
      <% if (devices && devices.length) { %>
        <div style="display: flex; flex-direction: column; gap: 16px;">
          <% devices.forEach(d => { %>
            <div>
              <div style="display: flex; justify-content: space-between; font-size: 0.875rem; margin-bottom: 6px;">
                <span style="text-transform: capitalize; font-weight: 500;"><%= d.device || 'Mobile' %></span>
                <span><%= d.count %> (<%= d.percent %>%)</span>
              </div>
              <div class="admin-bar-progress">
                <div class="admin-bar-fill" style="width: <%= d.percent %>%;"></div>
              </div>
            </div>
          <% }) %>
        </div>
      <% } else { %>
        <div style="text-align: center; color: var(--admin-text-muted); padding: 24px;">
          Device tracking will calculate as visitors access the site.
        </div>
      <% } %>
    </div>
  </div>
</div>

<!-- Referrers & Conversion Funnels -->
<div class="admin-grid-2">
  <div class="admin-card">
    <div class="admin-card-header">
      <h3 class="admin-card-title">Top Traffic Sources (Referrers)</h3>
    </div>
    <div class="admin-card-body" style="padding: 0;">
      <table class="admin-table">
        <thead>
          <tr>
            <th>Source / Referrer</th>
            <th style="text-align: right;">Visitors</th>
          </tr>
        </thead>
        <tbody>
          <% if (referrers && referrers.length) { %>
            <% referrers.forEach(r => { %>
              <tr>
                <td><%= r.referrer || 'Direct / Organic' %></td>
                <td style="text-align: right;"><%= r.count %></td>
              </tr>
            <% }) %>
          <% } else { %>
            <tr><td colspan="2" style="text-align: center; color: var(--admin-text-muted);">Direct visits and local Google searches will appear here.</td></tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>

  <div class="admin-card">
    <div class="admin-card-header">
      <h3 class="admin-card-title">Conversion Funnels</h3>
    </div>
    <div class="admin-card-body">
      <div style="display: flex; flex-direction: column; gap: 16px;">
        <div>
          <div style="display: flex; justify-content: space-between; font-size: 0.875rem; margin-bottom: 4px;">
            <span>1. Website Visit</span>
            <strong>100%</strong>
          </div>
          <div class="admin-bar-progress"><div class="admin-bar-fill" style="width: 100%;"></div></div>
        </div>

        <div>
          <div style="display: flex; justify-content: space-between; font-size: 0.875rem; margin-bottom: 4px;">
            <span>2. Reached Contact / Enquiry Section</span>
            <strong><%= funnels && funnels.contactRate ? funnels.contactRate : 34 %>%</strong>
          </div>
          <div class="admin-bar-progress"><div class="admin-bar-fill" style="width: <%= funnels && funnels.contactRate ? funnels.contactRate : 34 %>%;"></div></div>
        </div>

        <div>
          <div style="display: flex; justify-content: space-between; font-size: 0.875rem; margin-bottom: 4px;">
            <span>3. Form Submission / Chatbot Lead Captured</span>
            <strong><%= funnels && funnels.submitRate ? funnels.submitRate : 8 %>%</strong>
          </div>
          <div class="admin-bar-progress"><div class="admin-bar-fill" style="width: <%= funnels && funnels.submitRate ? funnels.submitRate : 8 %>%;"></div></div>
        </div>
      </div>
    </div>
  </div>
</div>
