<div class="admin-dashboard-grid">
  <!-- Stats Cards Row -->
  <div class="admin-stats-row">
    <div class="admin-stat-card">
      <div class="stat-header">
        <span class="stat-title">Visitors Today</span>
        <div class="stat-icon-wrap"><%- iconSvg('analytics') %></div>
      </div>
      <div class="stat-value"><%= stats.visitorsToday %></div>
      <div class="stat-meta"><%= stats.viewsToday %> total page views</div>
    </div>

    <div class="admin-stat-card">
      <div class="stat-header">
        <span class="stat-title">Enquiries This Week</span>
        <div class="stat-icon-wrap"><%- iconSvg('enquiries') %></div>
      </div>
      <div class="stat-value"><%= stats.enquiriesWeek %></div>
      <div class="stat-meta"><%= stats.conversionRate %>% estimated conversion</div>
    </div>

    <div class="admin-stat-card">
      <div class="stat-header">
        <span class="stat-title">Unread Leads</span>
        <div class="stat-icon-wrap"><%- iconSvg('leads') %></div>
      </div>
      <div class="stat-value" style="color: var(--admin-primary);"><%= stats.newEnquiries %></div>
      <div class="stat-meta"><%= stats.totalEnquiries %> total received</div>
    </div>

    <div class="admin-stat-card">
      <div class="stat-header">
        <span class="stat-title">Site Status</span>
        <div class="stat-icon-wrap"><%- iconSvg('maintenance') %></div>
      </div>
      <div class="stat-value" style="font-size: 1.5rem; text-transform: capitalize;">
        <span class="status-indicator <%= siteStatus === 'Live' ? 'online' : 'warning' %>"></span>
        <%= siteStatus %>
      </div>
      <div class="stat-meta">
        <% if (lastBackup) { %>
          Backup: <%= new Date(lastBackup.created_at).toLocaleDateString('en-IN') %>
        <% } else { %>
          No backups recorded
        <% } %>
      </div>
    </div>
  </div>

  <!-- Quick Actions Bar -->
  <div class="admin-card" style="margin-bottom: 24px;">
    <div class="admin-card-header">
      <h2 class="admin-card-title">Quick Actions</h2>
    </div>
    <div class="admin-card-body" style="display: flex; gap: 12px; flex-wrap: wrap;">
      <a href="/admin/content/pages" class="admin-btn admin-btn-outline">
        <%- iconSvg('edit') %> <span>Edit Page Content</span>
      </a>
      <a href="/admin/services" class="admin-btn admin-btn-outline">
        <%- iconSvg('services') %> <span>Manage Services</span>
      </a>
      <a href="/admin/brands" class="admin-btn admin-btn-outline">
        <%- iconSvg('brands') %> <span>Upload Brand Logo</span>
      </a>
      <a href="/admin/enquiries" class="admin-btn admin-btn-outline">
        <%- iconSvg('enquiries') %> <span>View Leads</span>
      </a>
      <a href="/admin/backups" class="admin-btn admin-btn-outline">
        <%- iconSvg('backups') %> <span>Snapshot DB</span>
      </a>
      <form action="/admin/maintenance/toggle" method="POST" style="display: inline;">
        <input type="hidden" name="_csrf" value="<%= locals.csrfToken || '' %>">
        <button type="submit" class="admin-btn <%= siteStatus === 'Live' ? 'admin-btn-outline' : 'admin-btn-primary' %>">
          <%- iconSvg('maintenance') %>
          <span><%= siteStatus === 'Live' ? 'Enter Maintenance' : 'Disable Maintenance' %></span>
        </button>
      </form>
    </div>
  </div>

  <!-- Two Column Layout: Recent Leads + Top Pages -->
  <div class="admin-grid-2" style="margin-bottom: 24px;">
    <!-- Recent Enquiries -->
    <div class="admin-card">
      <div class="admin-card-header" style="display: flex; justify-content: space-between; align-items: center;">
        <h2 class="admin-card-title">Recent Project Enquiries</h2>
        <a href="/admin/enquiries" class="admin-link-subtle">View all &rarr;</a>
      </div>
      <div class="admin-card-body" style="padding: 0;">
        <% if (recentEnquiries && recentEnquiries.length) { %>
          <div class="admin-table-responsive">
            <table class="admin-table">
              <thead>
                <tr>
                  <th>Client</th>
                  <th>Service</th>
                  <th>Status</th>
                  <th>Date</th>
                  <th>Action</th>
                </tr>
              </thead>
              <tbody>
                <% recentEnquiries.forEach(enq => { %>
                  <tr>
                    <td>
                      <strong><%= enq.name %></strong>
                      <% if (enq.company) { %>
                        <div style="font-size: 0.75rem; color: var(--admin-text-muted);"><%= enq.company %></div>
                      <% } %>
                    </td>
                    <td><%= enq.service || 'General' %></td>
                    <td>
                      <span class="status-badge status-<%= enq.status %>"><%= enq.status %></span>
                    </td>
                    <td style="font-size: 0.8125rem; color: var(--admin-text-muted);">
                      <%= new Date(enq.created_at).toLocaleDateString('en-IN', { month: 'short', day: 'numeric' }) %>
                    </td>
                    <td>
                      <a href="/admin/enquiries/<%= enq.id %>" class="admin-btn-sm">Review</a>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        <% } else { %>
          <div style="padding: 32px; text-align: center; color: var(--admin-text-muted);">
            No enquiries received yet. Forms on your website will automatically appear here.
          </div>
        <% } %>
      </div>
    </div>

    <!-- Top Pages Breakdown -->
    <div class="admin-card">
      <div class="admin-card-header" style="display: flex; justify-content: space-between; align-items: center;">
        <h2 class="admin-card-title">Top Viewed Pages (7 Days)</h2>
        <a href="/admin/analytics" class="admin-link-subtle">Full analytics &rarr;</a>
      </div>
      <div class="admin-card-body">
        <% if (topPages && topPages.length) { %>
          <div style="display: flex; flex-direction: column; gap: 16px;">
            <% topPages.forEach(p => { %>
              <div>
                <div style="display: flex; justify-content: space-between; font-size: 0.875rem; margin-bottom: 6px;">
                  <span style="font-weight: 500;"><%= p.path %></span>
                  <span style="color: var(--admin-text-muted);"><%= p.views %> views</span>
                </div>
                <div class="admin-bar-progress">
                  <% const maxViews = topPages[0].views || 1; %>
                  <div class="admin-bar-fill" style="width: <%= Math.min(100, Math.round((p.views / maxViews) * 100)) %>%;"></div>
                </div>
              </div>
            <% }) %>
          </div>
        <% } else { %>
          <div style="padding: 32px; text-align: center; color: var(--admin-text-muted);">
            Privacy analytics will populate as visitors browse the website.
          </div>
        <% } %>
      </div>
    </div>
  </div>

  <!-- Uptime & System Monitoring Card -->
  <div class="admin-card">
    <div class="admin-card-header">
      <h2 class="admin-card-title">Website Health &amp; Uptime (Internal Monitor)</h2>
    </div>
    <div class="admin-card-body" style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 16px;">
      <div>
        <div style="font-size: 1.125rem; font-weight: 600; color: var(--admin-text);">
          Status: <%= uptimeSummary ? uptimeSummary.status : 'Operational' %>
        </div>
        <div style="font-size: 0.875rem; color: var(--admin-text-muted); margin-top: 4px;">
          Checks runs every 60 seconds against the local server endpoint.
        </div>
      </div>
      <div style="text-align: right;">
        <div style="font-size: 1.25rem; font-weight: 700; color: var(--admin-primary);">
          <%= uptimeSummary && uptimeSummary.uptime_pct ? uptimeSummary.uptime_pct : '100' %>%
        </div>
        <div style="font-size: 0.75rem; color: var(--admin-text-muted);">30-day uptime record</div>
      </div>
    </div>
  </div>
</div>
