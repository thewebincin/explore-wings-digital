<div class="admin-page-header" style="margin-bottom: 24px;">
  <h2 style="font-size: 1.5rem; font-weight: 700;">System &amp; Email Settings</h2>
  <p style="font-size: 0.875rem; color: var(--admin-text-muted); margin-top: 4px;">
    Configure outgoing email (SMTP) for client lead notifications, visitor auto-replies, and password security.
  </p>
</div>

<div class="admin-grid-layout-sidebar">
  <!-- Left Main Column: SMTP Configuration -->
  <div style="display: flex; flex-direction: column; gap: 24px;">
    <div class="admin-card">
      <div class="admin-card-header">
        <h3 class="admin-card-title">SMTP Mail Server Settings</h3>
      </div>
      <div class="admin-card-body">
        <form action="/admin/settings/smtp" method="POST">
          <input type="hidden" name="_csrf" value="<%= locals.csrfToken || '' %>">

          <div class="admin-grid-2">
            <div class="admin-form-group">
              <label class="admin-label">SMTP Host</label>
              <input type="text" name="smtp_host" class="admin-input" value="<%= settings.smtp_host || '' %>" placeholder="smtp.gmail.com or smtp.mailgun.org">
            </div>
            <div class="admin-form-group">
              <label class="admin-label">SMTP Port</label>
              <input type="number" name="smtp_port" class="admin-input" value="<%= settings.smtp_port || 587 %>">
            </div>
          </div>

          <div class="admin-grid-2">
            <div class="admin-form-group">
              <label class="admin-label">SMTP Username / Email</label>
              <input type="text" name="smtp_user" class="admin-input" value="<%= settings.smtp_user || '' %>" placeholder="hello@explorewings.com">
            </div>
            <div class="admin-form-group">
              <label class="admin-label">SMTP Password / App Password</label>
              <input type="password" name="smtp_pass" class="admin-input" value="<%= settings.smtp_pass ? '••••••••••••' : '' %>" placeholder="••••••••••••">
            </div>
          </div>

          <div class="admin-form-group">
            <label class="admin-label">From Sender Address</label>
            <input type="text" name="smtp_from" class="admin-input" value="<%= settings.smtp_from || '' %>" placeholder='"Explore Wings Digital" <hello@explorewings.com>'>
          </div>

          <button type="submit" class="admin-btn admin-btn-primary" style="margin-top: 12px;">
            Save SMTP Settings
          </button>
        </form>
      </div>
    </div>

    <!-- Test Email Trigger -->
    <div class="admin-card">
      <div class="admin-card-header">
        <h3 class="admin-card-title">Send Test Email</h3>
      </div>
      <div class="admin-card-body">
        <p style="font-size: 0.8125rem; color: var(--admin-text-muted); margin-bottom: 16px;">
          Dispatches a diagnostic message to verify authentication and deliverability.
        </p>

        <form action="/admin/settings/smtp/test" method="POST">
          <input type="hidden" name="_csrf" value="<%= locals.csrfToken || '' %>">
          <div style="display: flex; gap: 8px; max-width: 480px;">
            <input type="email" name="test_recipient" class="admin-input" placeholder="Recipient email address" required value="<%= user ? user.email : '' %>">
            <button type="submit" class="admin-btn admin-btn-outline" style="white-space: nowrap;">Send Test</button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <!-- Right Column: Security & Password Update -->
  <div class="admin-card">
    <div class="admin-card-header">
      <h3 class="admin-card-title">Change Password</h3>
    </div>
    <div class="admin-card-body">
      <form action="/admin/settings/password" method="POST">
        <input type="hidden" name="_csrf" value="<%= locals.csrfToken || '' %>">

        <div class="admin-form-group">
          <label class="admin-label">Current Password *</label>
          <input type="password" name="current_password" class="admin-input" required>
        </div>

        <div class="admin-form-group">
          <label class="admin-label">New Password * (Min. 8 characters)</label>
          <input type="password" name="new_password" class="admin-input" required minlength="8">
        </div>

        <div class="admin-form-group">
          <label class="admin-label">Confirm New Password *</label>
          <input type="password" name="confirm_password" class="admin-input" required minlength="8">
        </div>

        <button type="submit" class="admin-btn admin-btn-primary" style="width: 100%; justify-content: center; margin-top: 12px;">
          Update Password
        </button>
      </form>
    </div>
  </div>
</div>
