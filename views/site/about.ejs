<%
  const sec = sections || {};
  const heroSec = sec.header || sec.hero || {};
  const storySec = sec.story || {};
  const founderSec = sec.founder_quote || sec.founder || {};
  const ctaSec = sec.cta || {};
%>

<!-- PAGE HERO -->
<section class="page-hero-editorial" aria-label="About Explore Wings">
  <div class="container">
    <div style="max-width: 800px;">
      <span class="stamp-badge">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="10"></circle>
          <path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"></path>
          <path d="M2 12h20"></path>
        </svg>
        <%= heroSec.badge || heroSec.subtitle || 'Our Roots & Philosophy' %>
      </span>
      <h1 class="page-headline" style="margin-top: 16px;">
        <%- heroSec.title || heroSec.headline || 'Built in Trivandrum for businesses who value direct, unhurried work.' %>
      </h1>
      <p class="page-lead" style="margin-top: 16px;">
        <%= heroSec.subtitle || heroSec.lead || 'We are a digital studio based in Thiruvananthapuram, Kerala. We build high-speed websites, design authentic brand identities, and capture local commercial media.' %>
      </p>
    </div>
  </div>
</section>

<!-- STORY & FOUNDER NOTE -->
<section style="padding: var(--space-2xl) 0; border-bottom: 1px solid var(--border);">
  <div class="container about-story-grid">
    <div>
      <span class="stamp-badge"><%= storySec.subtitle || 'Why We Started' %></span>
      <h2 style="font-size: 2rem; margin: 12px 0 20px;"><%= storySec.title || 'A direct alternative to bloated agencies and unreliable freelancers.' %></h2>
      <% if (storySec.body) { %>
        <% storySec.body.split('\n\n').forEach(paragraph => { %>
          <p style="color: var(--text-muted); font-size: 1rem; line-height: 1.65; margin-bottom: 16px;"><%= paragraph.trim() %></p>
        <% }) %>
      <% } else { %>
        <p style="color: var(--text-muted); font-size: 1rem; line-height: 1.65; margin-bottom: 16px;">
          For years, business owners across Kerala faced an uncomfortable choice: hire large tech agencies that charge exorbitant fees and pass client accounts down to inexperienced interns, or hire unvetted freelancers who disappear halfway through a project.
        </p>
        <p style="color: var(--text-muted); font-size: 1rem; line-height: 1.65; margin-bottom: 16px;">
          Explore Wings Digital Technologies was founded in Trivandrum to offer a direct alternative. When you work with us, you speak directly with the people building your code, designing your identity, and running your ads.
        </p>
        <p style="color: var(--text-muted); font-size: 1rem; line-height: 1.65;">
          We understand the local Kerala market intimately. We know the rhythm of tourist seasons in Kovalam and Varkala, the commercial activity around Technopark and Kazhakkoottam, and how shoppers in Kowdiar and East Fort discover services on their phones.
        </p>
      <% } %>
    </div>

    <!-- Founder Note Card -->
    <div style="background: var(--bg-card); border: 1px solid var(--border); border-radius: var(--radius-md); padding: 32px; display: flex; flex-direction: column; gap: 16px; box-shadow: var(--shadow-sm);" data-reveal>
      <div style="display: flex; align-items: center; gap: 12px; border-bottom: 1px solid var(--border); padding-bottom: 16px;">
        <div class="brand-chip">
          <img src="<%= settings.logo_path || '/images/logo.png' %>" alt="Explore Wings" width="28" height="28">
        </div>
        <div>
          <strong style="font-size: 1rem; color: var(--text);"><%= founderSec.title || 'A note from our founder' %></strong>
          <span style="display: block; font-size: 0.75rem; color: var(--text-muted);"><%= founderSec.subtitle || settings.address || 'Trivandrum, Kerala' %></span>
        </div>
      </div>
      <p style="font-size: 0.9375rem; color: var(--text); line-height: 1.6; font-style: italic;">
        &ldquo;<%= founderSec.body || founderSec.note || 'When I started Explore Wings, my pledge was simple: never use canned marketing buzzwords, never invent fake numbers or testimonials, and never leave a client wondering what they paid for. Every website we build must load fast on an ordinary mobile connection, and every rupee spent on marketing must be accounted for.' %>&rdquo;
      </p>
      <div style="margin-top: auto; padding-top: 14px; border-top: 1px dashed var(--border); font-size: 0.8125rem; color: var(--primary); font-weight: 600;">
        Explore Wings Digital Technologies &bull; Thiruvananthapuram
      </div>
    </div>
  </div>
</section>

<!-- COMMITMENTS -->
<section style="padding: var(--space-2xl) 0; border-bottom: 1px solid var(--border);">
  <div class="container">
    <span class="stamp-badge">Our Commitments</span>
    <h2 class="section-title" style="margin-top: 8px;">What you can expect from us on every project.</h2>
    
    <div class="about-values-grid">
      <div class="value-box" data-reveal>
        <span class="value-num">01</span>
        <h3 style="font-size: 1.25rem;">Fixed Timelines &amp; Written Quotes</h3>
        <p style="font-size: 0.875rem; color: var(--text-muted); line-height: 1.55;">
          Before writing a single line of code, we give you a written milestone schedule and an itemized quote. What you sign is what you pay.
        </p>
      </div>

      <div class="value-box" data-reveal>
        <span class="value-num">02</span>
        <h3 style="font-size: 1.25rem;">Direct Developer Communication</h3>
        <p style="font-size: 0.875rem; color: var(--text-muted); line-height: 1.55;">
          No middle managers or scripted account reps. When you call or WhatsApp, you talk to the person working on your project.
        </p>
      </div>

      <div class="value-box" data-reveal>
        <span class="value-num">03</span>
        <h3 style="font-size: 1.25rem;">100% Asset Ownership</h3>
        <p style="font-size: 0.875rem; color: var(--text-muted); line-height: 1.55;">
          You own all source code, graphic vectors, photos, domain names, and hosting logins. We never hold your digital assets hostage.
        </p>
      </div>
    </div>
  </div>
</section>

<!-- LOCAL LANDMARKS -->
<section class="trivandrum-local-strip" style="padding: var(--space-2xl) 0; border-bottom: 1px solid var(--border);">
  <div class="container">
    <span class="stamp-badge">Local Presence</span>
    <h2 class="section-title" style="margin-top: 8px;">Proudly rooted in Trivandrum.</h2>
    <p class="sub-title" style="margin-top: 8px;">
      Our studio is in Thiruvananthapuram, Kerala's capital. We live and work alongside the businesses we serve.
    </p>

    <div class="local-landmarks-grid">
      <div class="landmark-card" data-reveal>
        <strong>Technopark &amp; Kazhakkoottam</strong>
        <p>Minutes from India's pioneering IT park, serving tech firms, startups, and consulting agencies with sharp web applications.</p>
      </div>
      <div class="landmark-card" data-reveal>
        <strong>Kovalam &amp; Varkala Coastal Belt</strong>
        <p>Partnering with boutique ayurvedic resorts, beachfront retreats, and hospitality brands to drive direct guest bookings.</p>
      </div>
      <div class="landmark-card" data-reveal>
        <strong>City Centre &amp; Kowdiar</strong>
        <p>Working directly with specialty clinics, retail showrooms, restaurants, and educational consultancies across the city.</p>
      </div>
    </div>
  </div>
</section>

<!-- BRANDS SCROLLER -->
<% if (brands && brands.length) { %>
<section class="brands-scroller-section" aria-label="Brands that trust us">
  <div class="container scroller-section-header">
    <span class="stamp-badge">Local Partners</span>
    <h2 class="section-title" style="margin-top: 8px;">Brands that trust Explore Wings in Kerala.</h2>
  </div>

  <div class="scroller-track-container">
    <div class="scroller-track track-row-1">
      <% brands.forEach(brand => { %>
        <div class="brand-scroll-pill">
          <img src="<%= brand.logo || brand.logo_url %>" alt="<%= brand.name %>" loading="lazy">
          <span><%= brand.name %></span>
        </div>
      <% }) %>
      <% brands.forEach(brand => { %>
        <div class="brand-scroll-pill">
          <img src="<%= brand.logo || brand.logo_url %>" alt="<%= brand.name %>" loading="lazy">
          <span><%= brand.name %></span>
        </div>
      <% }) %>
    </div>
  </div>
</section>
<% } %>

<!-- BOTTOM CTA BAND -->
<section class="cta-editorial-band" style="background: var(--bg-card); border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); padding: var(--space-2xl) 0;">
  <div class="container" style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 24px;">
    <div>
      <span class="stamp-badge"><%= ctaSec.badge || 'Meet with us' %></span>
      <h2 style="font-size: 1.75rem; margin-top: 8px;"><%= ctaSec.headline || 'Want to discuss your project in person?' %></h2>
      <p style="color: var(--text-muted); margin-top: 6px;"><%= ctaSec.sub || 'We are happy to meet at your office in Trivandrum or host a consultation.' %></p>
    </div>
    <div>
      <a href="/contact" class="btn-primary">
        <span>Get in touch</span>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="5" y1="12" x2="19" y2="12"></line>
          <polyline points="12 5 19 12 12 19"></polyline>
        </svg>
      </a>
    </div>
  </div>
</section>
