<%
  const sec = sections || {};
  const heroSec = sec.header || sec.hero || {};
%>

<!-- PAGE HERO -->
<section class="page-hero-editorial" aria-label="Contact Header">
  <div class="container">
    <div style="max-width: 800px;">
      <span class="stamp-badge">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
        </svg>
        <%= heroSec.badge || heroSec.subtitle || 'Direct Studio Contact' %>
      </span>
      <h1 class="page-headline" style="margin-top: 16px;">
        <%- heroSec.title || heroSec.headline || 'Speak directly with our team in Trivandrum.' %>
      </h1>
      <p class="page-lead" style="margin-top: 16px;">
        <%= heroSec.subtitle || heroSec.lead || 'Whether you need a full website built, a fresh brand identity, or commercial photography in Kerala, send us a note or call our studio directly.' %>
      </p>
    </div>
  </div>
</section>

<!-- CONTACT SECTION -->
<section class="contact-page-section" style="padding: var(--space-2xl) 0;">
  <div class="container contact-grid-2">
    <!-- Left Column: Studio Channels (Hiding empty fields) -->
    <div class="contact-channels-col" data-reveal="left">
      <% if (settings.phone) { %>
        <div class="contact-info-card">
          <div class="card-icon">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
          </div>
          <div>
            <strong>Direct Phone</strong>
            <a href="tel:<%= settings.phone.replace(/[^0-9+]/g, '') %>"><%= settings.phone %></a>
          </div>
        </div>
      <% } %>

      <% if (settings.email) { %>
        <div class="contact-info-card">
          <div class="card-icon">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
          </div>
          <div>
            <strong>Email Address</strong>
            <a href="mailto:<%= settings.email %>"><%= settings.email %></a>
          </div>
        </div>
      <% } %>

      <% if (settings.whatsapp) { %>
        <div class="contact-info-card">
          <div class="card-icon">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path></svg>
          </div>
          <div>
            <strong>WhatsApp Quick Chat</strong>
            <a href="https://wa.me/<%= settings.whatsapp.replace(/[^0-9]/g, '') %>" target="_blank" rel="noopener" style="color: #25D366; font-weight: 600;">Message us on WhatsApp &rarr;</a>
          </div>
        </div>
      <% } %>

      <% if (settings.address) { %>
        <div class="contact-info-card">
          <div class="card-icon">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
          </div>
          <div>
            <strong>Studio Location</strong>
            <p><%= settings.address %></p>
          </div>
        </div>
      <% } %>

      <% if (settings.hours) { %>
        <div class="contact-info-card">
          <div class="card-icon">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
          </div>
          <div>
            <strong>Office Hours</strong>
            <p><%= settings.hours %></p>
          </div>
        </div>
      <% } %>
    </div>

    <!-- Right Column: Project Enquiry Form -->
    <div class="enquiry-card-wrapper" data-reveal="right">
      <h2 style="font-size: 1.5rem; margin-bottom: 6px;">Send us a message</h2>
      <p style="color: var(--text-muted); font-size: 0.875rem; margin-bottom: 20px;">
        Leave your details and project outline. We reply within one business day.
      </p>

      <form class="project-enquiry-form" id="mainContactForm" action="/api/enquiry" method="POST" enctype="multipart/form-data">
        <!-- Anti-spam Honeypot -->
        <input type="text" name="_hp" style="display:none;" tabindex="-1" autocomplete="off">
        <input type="hidden" name="source_page" value="contact">

        <div class="form-grid-2">
          <div class="field-group">
            <label for="contactName">Your Name *</label>
            <input type="text" id="contactName" name="name" placeholder="e.g. Maya Sreedharan" required>
          </div>
          <div class="field-group">
            <label for="contactPhoneEmail">Phone or Email *</label>
            <input type="text" id="contactPhoneEmail" name="contact" placeholder="e.g. +91 94460 00000 or maya@firm.in" required>
          </div>
        </div>

        <div class="form-grid-2">
          <div class="field-group">
            <label for="contactCompany">Company / Business Name</label>
            <input type="text" id="contactCompany" name="company" placeholder="e.g. Kowdiar Ayurveda Clinic">
          </div>
          <div class="field-group">
            <label for="contactService">What can we help you with? *</label>
            <select id="contactService" name="service" required>
              <option value="" disabled <%= !prefillService && !prefillPackage ? 'selected' : '' %>>Select a primary service</option>
              <option value="Custom Website" <%= (prefillService === 'websites' || prefillService === 'Custom Website') ? 'selected' : '' %>>Custom Website / Web App</option>
              <option value="Brand Identity" <%= (prefillService === 'branding' || prefillService === 'Brand Identity') ? 'selected' : '' %>>Brand Identity &amp; Logo Design</option>
              <option value="Social Media" <%= (prefillService === 'social' || prefillService === 'Social Media') ? 'selected' : '' %>>Social Media Management</option>
              <option value="Photography & Video" <%= (prefillService === 'photo' || prefillService === 'photography' || prefillService === 'Photography & Video') ? 'selected' : '' %>>Photography &amp; Commercial Video</option>
              <option value="Digital Marketing" <%= (prefillService === 'marketing' || prefillService === 'Digital Marketing') ? 'selected' : '' %>>Performance Digital Marketing</option>
              <option value="Local SEO" <%= (prefillService === 'localseo' || prefillService === 'Local SEO') ? 'selected' : '' %>>Google Search &amp; Local SEO</option>
              <option value="Essential Package" <%= prefillPackage === 'essential' ? 'selected' : '' %>>Essential Package Tier</option>
              <option value="Signature Package" <%= prefillPackage === 'signature' ? 'selected' : '' %>>Signature Package Tier</option>
              <option value="Growth Package" <%= prefillPackage === 'growth' ? 'selected' : '' %>>Growth Package Tier</option>
              <option value="Complete Overhaul">Complete Digital Overhaul</option>
            </select>
          </div>
        </div>

        <div class="field-group">
          <label for="contactMessage">Project Details &amp; Current Online Links</label>
          <textarea id="contactMessage" name="details" rows="5" placeholder="Share your timeline, current website or Instagram links, and what you would like to achieve."></textarea>
        </div>

        <div class="field-group">
          <label for="contactAttachment">Attachment / Brief (Optional, max 10MB)</label>
          <input type="file" id="contactAttachment" name="attachment" accept=".pdf,.doc,.docx,.png,.jpg,.jpeg,.webp">
        </div>

        <button type="submit" class="btn-primary" style="align-self: flex-start;">
          <span>Submit project enquiry</span>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </button>
      </form>
    </div>
  </div>
</section>
