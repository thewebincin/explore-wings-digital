<!-- Floating WhatsApp Button (Every Page) -->
<% 
  const waNumClean = ((locals.settings && locals.settings.whatsapp_number) || '918921309190').replace(/[^0-9]/g, '');
  const waDefaultText = encodeURIComponent((locals.settings && locals.settings.whatsapp_default_msg) || "Hi Explore Wings, I'd like to know more about your services.");
%>
<a
  href="https://wa.me/<%= waNumClean %>?text=<%= waDefaultText %>"
  class="whatsapp-float"
  id="floatingWhatsappBtn"
  target="_blank"
  rel="noopener noreferrer"
  aria-label="Chat with Explore Wings Digital on WhatsApp"
  onclick="fetch('/api/analytics/whatsapp-click').catch(function(){});"
>
