<!-- ========================================================================
     TWO-COLUMN CONTACT SECTION (Trivandrum HQ + Multi-Step Project Enquiry Form)
     ======================================================================== -->
<section class="section section-tint contact-section-tint" id="contact-project-section">
  <div class="container">
    <div class="section-header" data-reveal="up" style="margin-bottom: 2.5rem;">
      <span class="eyebrow"><span class="eyebrow-dot"></span> <span>Trivandrum Creative &amp; Tech Studio</span></span>
      <h2 class="display-lg">Tell us about your project</h2>
      <p class="body-lg" style="margin-top: 0.5rem; color: var(--theme-primary); font-weight: 600;">
        We reply within one working day.
      </p>
    </div>

    <div class="contact-layout-grid" style="display: grid; grid-template-columns: 1fr; gap: 2rem; align-items: start;">
      <!-- ====================================================================
           LEFT COLUMN: 3 Large Contact Cards, Working Hours, What Happens Next, Map
           ==================================================================== -->
      <div class="contact-info-stack" data-stagger="80">
        <!-- 1. Direct Call Card -->
        <div class="contact-info-card" data-reveal="left" style="display: flex; gap: 1.25rem; align-items: flex-start;">
          <div class="contact-card-icon" style="width: 52px; height: 52px; border-radius: 14px; background: rgba(var(--theme-rgb), 0.12); color: var(--theme-primary); display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
            </svg>
          </div>
          <div>
            <h4 style="font-size: 1.05rem; font-weight: 700; margin-bottom: 0.35rem;">Direct Phone &amp; Desk</h4>
            <p style="font-size: 0.88rem; color: var(--text-muted); margin-bottom: 0.5rem;">Tap to speak directly with our team:</p>
            <div style="display: flex; flex-direction: column; gap: 0.35rem;">
              <a href="tel:+917510405067" class="contact-tap-link" style="font-weight: 700; color: var(--text-primary); text-decoration: underline; font-size: 0.95rem; min-height: 44px; display: inline-flex; align-items: center;">
                📞 +91 75104 05067
              </a>
              <a href="tel:+916238976168" class="contact-tap-link" style="font-weight: 700; color: var(--text-primary); text-decoration: underline; font-size: 0.95rem; min-height: 44px; display: inline-flex; align-items: center;">
                📞 +91 62389 76168
              </a>
            </div>
          </div>
        </div>

        <!-- 2. WhatsApp Business Card -->
        <div class="contact-info-card" data-reveal="left" style="display: flex; gap: 1.25rem; align-items: flex-start;">
          <div class="contact-card-icon" style="width: 52px; height: 52px; border-radius: 14px; background: rgba(37, 211, 102, 0.12); color: #25D366; display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
            <svg viewBox="0 0 32 32" width="26" height="26" fill="currentColor">
              <path d="M16.002 2.667C8.64 2.667 2.667 8.64 2.667 16c0 2.587.74 5.007 2.02 7.067L2.667 29.333l6.453-1.987A13.255 13.255 0 0016.002 29.333c7.36 0 13.333-5.973 13.333-13.333S23.362 2.667 16.002 2.667zm7.8 18.847c-.327.92-1.62 1.687-2.64 1.907-.7.147-1.613.267-4.687-1.007-3.927-1.627-6.467-5.613-6.66-5.873-.193-.26-1.587-2.113-1.587-4.027 0-1.913.993-2.86 1.347-3.247.353-.387.773-.487 1.033-.487.26 0 .52.007.747.02.24.013.56-.093.88.673.327.767 1.113 2.72 1.213 2.92.1.2.167.44.033.7-.133.267-.2.433-.4.667-.2.233-.42.52-.6.7-.2.2-.413.42-.18.82.233.4 1.04 1.713 2.233 2.773 1.533 1.367 2.827 1.793 3.227 1.993.4.2.633.167.867-.1.233-.267 1-1.167 1.267-1.567.267-.4.533-.333.9-.2.367.133 2.327 1.1 2.727 1.3.4.2.667.3.767.467.1.167.1.967-.227 1.887z"/>
            </svg>
          </div>
          <div>
            <h4 style="font-size: 1.05rem; font-weight: 700; margin-bottom: 0.35rem;">WhatsApp Business</h4>
            <p style="font-size: 0.88rem; color: var(--text-muted); margin-bottom: 0.75rem;">+91 89213 09190 • Instant chat &amp; quote queries</p>
            <a
              href="https://wa.me/918921309190?text=Hi%20Explore%20Wings%2C%20I%27d%20like%20to%20know%20more%20about%20your%20services."
              target="_blank"
              rel="noopener noreferrer"
              class="btn btn-sm btn-accent"
              style="min-height: 44px; padding: 0.55rem 1.25rem; font-size: 0.88rem; display: inline-flex; align-items: center; gap: 8px;"
              onclick="fetch('/api/analytics/whatsapp-click').catch(function(){});"
            >
              <span>Chat now</span>
              <span class="btn-arrow">→</span>
            </a>
          </div>
        </div>

        <!-- 3. Address Card -->
        <div class="contact-info-card" data-reveal="left" style="display: flex; gap: 1.25rem; align-items: flex-start;">
          <div class="contact-card-icon" style="width: 52px; height: 52px; border-radius: 14px; background: rgba(var(--theme-rgb), 0.12); color: var(--theme-primary); display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
              <circle cx="12" cy="10" r="3"></circle>
            </svg>
          </div>
          <div>
            <h4 style="font-size: 1.05rem; font-weight: 700; margin-bottom: 0.35rem;">Studio Location</h4>
            <p style="font-size: 0.88rem; color: var(--text-muted); line-height: 1.6;">
              Trivandrum (Thiruvananthapuram), Kerala, India
            </p>
          </div>
        </div>

        <!-- 4. Working Hours -->
        <div class="contact-info-card" data-reveal="left" style="display: flex; gap: 1.25rem; align-items: flex-start;">
          <div class="contact-card-icon" style="width: 52px; height: 52px; border-radius: 14px; background: rgba(var(--theme-rgb), 0.12); color: var(--theme-primary); display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"></circle>
              <polyline points="12 6 12 12 16 14"></polyline>
            </svg>
          </div>
          <div>
            <h4 style="font-size: 1.05rem; font-weight: 700; margin-bottom: 0.35rem;">Working Hours</h4>
            <p style="font-size: 0.88rem; color: var(--text-muted); line-height: 1.6;">
              <%= (locals.settings && locals.settings.hours) || 'Monday – Saturday: 9:30 AM – 6:30 PM IST' %>
            </p>
          </div>
        </div>

        <!-- 5. What Happens Next (3 Steps) -->
        <div class="contact-info-card" data-reveal="left" style="flex-direction: column;">
          <h4 style="font-size: 1.05rem; font-weight: 700; margin-bottom: 0.85rem; display: flex; align-items: center; gap: 8px;">
            <span>📋</span> What happens next
          </h4>
          <div style="display: flex; flex-direction: column; gap: 0.75rem; font-size: 0.88rem; color: var(--text-muted); line-height: 1.5;">
            <div>
              <strong style="color: var(--text-primary);">1. Quick Discovery:</strong> We review your goals and existing presence within 24 hours.
            </div>
            <div>
              <strong style="color: var(--text-primary);">2. Strategy Call:</strong> A focused 30-minute consultation or WhatsApp chat to clarify scope.
            </div>
            <div>
              <strong style="color: var(--text-primary);">3. Clear Proposal:</strong> You receive a transparent breakdown of work, timeline, and exact pricing.
            </div>
          </div>
        </div>

        <!-- 6. Styled Map Card of Trivandrum -->
        <div class="contact-info-card" data-reveal="left" style="flex-direction: column; padding: 1.25rem;">
          <div style="width: 100%; height: 210px; border-radius: 12px; overflow: hidden; border: 1px solid var(--border-subtle); margin-bottom: 0.85rem;">
            <iframe
              title="Explore Wings Digital Technologies — Trivandrum Map"
              src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d126271.88635351292!2d76.8541259!3d8.5000379!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x3b05bbb805bbcd47%3A0x15439fab5c5c81cb!2sThiruvananthapuram%2C%20Kerala!5e0!3m2!1sen!2sin!4v1700000000000!5m2!1sen!2sin"
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
              style="width: 100%; height: 100%; border: 0;"
            ></iframe>
          </div>
          <a
            href="https://maps.google.com/?q=Thiruvananthapuram,Kerala,India"
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-outline"
            style="width: 100%; min-height: 44px; justify-content: center; font-size: 0.88rem;"
          >
            <span>Open in Google Maps ↗</span>
          </a>
        </div>
      </div>

      <!-- ====================================================================
           RIGHT COLUMN: 4-Step Multi-Step Project Enquiry Form
           ==================================================================== -->
      <div class="contact-form-card" data-reveal="right" style="position: sticky; top: 96px;">
        <!-- Form Header & Progress Indicator -->
        <div style="margin-bottom: 1.5rem;">
          <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
            <span class="eyebrow" style="margin: 0;">Step <span id="enquiryCurrentStepNum">1</span> of 4</span>
            <span id="enquiryStepTitle" style="font-size: 0.82rem; font-weight: 700; color: var(--theme-primary);">About you</span>
          </div>
          <div class="form-progress-track" style="margin: 0; height: 6px; background: var(--bg-elevated); border-radius: 99px; overflow: hidden;">
            <div id="enquiryStepProgressFill" style="width: 25%; height: 100%; background: linear-gradient(90deg, var(--theme-primary), var(--theme-accent)); transition: width 0.35s ease;"></div>
          </div>
        </div>

        <!-- The Multi-Step Form Container -->
        <form id="multiStepEnquiryForm" novalidate onsubmit="return false;">
          <!-- ==============================================================
               STEP 1: ABOUT YOU
               ============================================================== -->
          <div class="enquiry-step-panel active" id="enquiryStep1" data-step="1">
            <h3 style="font-size: 1.25rem; font-weight: 700; margin-bottom: 0.35rem;">Let's get acquainted</h3>
            <p style="font-size: 0.88rem; color: var(--text-muted); margin-bottom: 1.25rem;">Enter your name and contact details to begin:</p>

            <div class="floating-group" style="margin-bottom: 1.25rem;">
              <input type="text" id="step1Name" class="floating-input" placeholder=" " required />
              <label for="step1Name" class="floating-label">Your Full Name *</label>
              <div class="field-error-msg" id="errName" style="color: #EF4444; font-size: 0.78rem; margin-top: 4px; display: none;">Please provide your name.</div>
            </div>

            <div class="floating-group" style="margin-bottom: 1.25rem;">
              <input type="tel" id="step1Phone" class="floating-input" placeholder=" " value="+91 " required />
              <label for="step1Phone" class="floating-label">Phone Number (10 digits) *</label>
              <div class="field-error-msg" id="errPhone" style="color: #EF4444; font-size: 0.78rem; margin-top: 4px; display: none;">Please enter a valid 10-digit mobile number (+91).</div>
            </div>

            <div class="floating-group" style="margin-bottom: 1.25rem;">
              <input type="email" id="step1Email" class="floating-input" placeholder=" " />
              <label for="step1Email" class="floating-label">Email Address (Optional if phone is given)</label>
            </div>

            <div class="floating-group" style="margin-bottom: 1.5rem;">
              <input type="text" id="step1Company" class="floating-input" placeholder=" " />
              <label for="step1Company" class="floating-label">Business / Brand Name (Optional)</label>
            </div>

            <button type="button" class="btn btn-primary" id="btnStep1Next" style="width: 100%; min-height: 48px; justify-content: center; font-size: 0.95rem;">
              <span>Next: Select Services</span>
              <span class="btn-arrow">→</span>
            </button>
          </div>

          <!-- ==============================================================
               STEP 2: YOUR PROJECT (Services needed)
               ============================================================== -->
          <div class="enquiry-step-panel" id="enquiryStep2" data-step="2" style="display: none;">
            <h3 style="font-size: 1.25rem; font-weight: 700; margin-bottom: 0.35rem;">What do you want to build?</h3>
            <p style="font-size: 0.88rem; color: var(--text-muted); margin-bottom: 1.25rem;">Select all services that apply to your project:</p>

            <div class="services-select-grid" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(210px, 1fr)); gap: 0.75rem; margin-bottom: 1.5rem;">
              <label class="service-pill-option" style="min-height: 44px; display: flex; align-items: center; gap: 10px; padding: 0.65rem 1rem; border-radius: 10px; border: 1.5px solid var(--border-subtle); background: var(--bg-elevated); cursor: pointer; user-select: none;">
                <input type="checkbox" name="services" value="Website Design" checked style="width: 18px; height: 18px; accent-color: var(--theme-primary);" />
                <span style="font-size: 0.88rem; font-weight: 600;">Website Design</span>
              </label>

              <label class="service-pill-option" style="min-height: 44px; display: flex; align-items: center; gap: 10px; padding: 0.65rem 1rem; border-radius: 10px; border: 1.5px solid var(--border-subtle); background: var(--bg-elevated); cursor: pointer; user-select: none;">
                <input type="checkbox" name="services" value="Branding & Logos" style="width: 18px; height: 18px; accent-color: var(--theme-primary);" />
                <span style="font-size: 0.88rem; font-weight: 600;">Branding &amp; Logos</span>
              </label>

              <label class="service-pill-option" style="min-height: 44px; display: flex; align-items: center; gap: 10px; padding: 0.65rem 1rem; border-radius: 10px; border: 1.5px solid var(--border-subtle); background: var(--bg-elevated); cursor: pointer; user-select: none;">
                <input type="checkbox" name="services" value="Social Media & Reels" style="width: 18px; height: 18px; accent-color: var(--theme-primary);" />
                <span style="font-size: 0.88rem; font-weight: 600;">Social Media &amp; Reels</span>
              </label>

              <label class="service-pill-option" style="min-height: 44px; display: flex; align-items: center; gap: 10px; padding: 0.65rem 1rem; border-radius: 10px; border: 1.5px solid var(--border-subtle); background: var(--bg-elevated); cursor: pointer; user-select: none;">
                <input type="checkbox" name="services" value="Photo & Video Shoots" style="width: 18px; height: 18px; accent-color: var(--theme-primary);" />
                <span style="font-size: 0.88rem; font-weight: 600;">Photo &amp; Video Shoots</span>
              </label>

              <label class="service-pill-option" style="min-height: 44px; display: flex; align-items: center; gap: 10px; padding: 0.65rem 1rem; border-radius: 10px; border: 1.5px solid var(--border-subtle); background: var(--bg-elevated); cursor: pointer; user-select: none;">
                <input type="checkbox" name="services" value="Digital Marketing & Local SEO" style="width: 18px; height: 18px; accent-color: var(--theme-primary);" />
                <span style="font-size: 0.88rem; font-weight: 600;">Digital Marketing &amp; SEO</span>
              </label>

              <label class="service-pill-option" style="min-height: 44px; display: flex; align-items: center; gap: 10px; padding: 0.65rem 1rem; border-radius: 10px; border: 1.5px solid var(--border-subtle); background: var(--bg-elevated); cursor: pointer; user-select: none;">
                <input type="checkbox" name="services" value="Business Web Application" style="width: 18px; height: 18px; accent-color: var(--theme-primary);" />
                <span style="font-size: 0.88rem; font-weight: 600;">Business Web Portals</span>
              </label>
            </div>

            <div style="display: flex; gap: 10px;">
              <button type="button" class="btn btn-outline" id="btnStep2Back" style="flex: 1; min-height: 48px; justify-content: center;">
                ← Back
              </button>
              <button type="button" class="btn btn-primary" id="btnStep2Next" style="flex: 2; min-height: 48px; justify-content: center;">
                <span>Next: Budget &amp; Timing</span>
                <span class="btn-arrow">→</span>
              </button>
            </div>
          </div>

          <!-- ==============================================================
               STEP 3: BUDGET & TIMING
               ============================================================== -->
          <div class="enquiry-step-panel" id="enquiryStep3" data-step="3" style="display: none;">
            <h3 style="font-size: 1.25rem; font-weight: 700; margin-bottom: 0.35rem;">Budget and timing</h3>
            <p style="font-size: 0.88rem; color: var(--text-muted); margin-bottom: 1.25rem;">Help us recommend the best engagement model:</p>

            <div style="margin-bottom: 1.25rem;">
              <label style="display: block; font-size: 0.82rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-muted); margin-bottom: 0.6rem;">Estimated Budget Tier</label>
              <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.65rem;">
                <label class="tier-pill-radio" style="min-height: 44px; display: flex; align-items: center; gap: 8px; padding: 0.65rem 0.85rem; border-radius: 8px; border: 1.5px solid var(--border-subtle); background: var(--bg-elevated); cursor: pointer; user-select: none;">
                  <input type="radio" name="budget_tier" value="Under ₹35,000" style="accent-color: var(--theme-primary);" />
                  <span style="font-size: 0.84rem; font-weight: 600;">Under ₹35,000</span>
                </label>
                <label class="tier-pill-radio" style="min-height: 44px; display: flex; align-items: center; gap: 8px; padding: 0.65rem 0.85rem; border-radius: 8px; border: 1.5px solid var(--theme-primary); background: var(--bg-elevated); cursor: pointer; user-select: none;">
                  <input type="radio" name="budget_tier" value="₹35,000 – ₹75,000" checked style="accent-color: var(--theme-primary);" />
                  <span style="font-size: 0.84rem; font-weight: 600;">₹35k – ₹75k (Signature)</span>
                </label>
                <label class="tier-pill-radio" style="min-height: 44px; display: flex; align-items: center; gap: 8px; padding: 0.65rem 0.85rem; border-radius: 8px; border: 1.5px solid var(--border-subtle); background: var(--bg-elevated); cursor: pointer; user-select: none;">
                  <input type="radio" name="budget_tier" value="₹75,000 – ₹1,50,000" style="accent-color: var(--theme-primary);" />
                  <span style="font-size: 0.84rem; font-weight: 600;">₹75k – ₹1.5 Lakh</span>
                </label>
                <label class="tier-pill-radio" style="min-height: 44px; display: flex; align-items: center; gap: 8px; padding: 0.65rem 0.85rem; border-radius: 8px; border: 1.5px solid var(--border-subtle); background: var(--bg-elevated); cursor: pointer; user-select: none;">
                  <input type="radio" name="budget_tier" value="₹1,50,000+" style="accent-color: var(--theme-primary);" />
                  <span style="font-size: 0.84rem; font-weight: 600;">₹1.5 Lakh+ (Custom)</span>
                </label>
              </div>
            </div>

            <div style="margin-bottom: 1.5rem;">
              <label style="display: block; font-size: 0.82rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-muted); margin-bottom: 0.6rem;">Target Launch Timeline</label>
              <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.65rem;">
                <label class="tier-pill-radio" style="min-height: 44px; display: flex; align-items: center; gap: 8px; padding: 0.65rem 0.85rem; border-radius: 8px; border: 1.5px solid var(--border-subtle); background: var(--bg-elevated); cursor: pointer; user-select: none;">
                  <input type="radio" name="timeline" value="Within 2 Weeks" style="accent-color: var(--theme-primary);" />
                  <span style="font-size: 0.84rem; font-weight: 600;">Within 2 Weeks</span>
                </label>
                <label class="tier-pill-radio" style="min-height: 44px; display: flex; align-items: center; gap: 8px; padding: 0.65rem 0.85rem; border-radius: 8px; border: 1.5px solid var(--theme-primary); background: var(--bg-elevated); cursor: pointer; user-select: none;">
                  <input type="radio" name="timeline" value="Within 1 Month" checked style="accent-color: var(--theme-primary);" />
                  <span style="font-size: 0.84rem; font-weight: 600;">1 Month (Standard)</span>
                </label>
                <label class="tier-pill-radio" style="min-height: 44px; display: flex; align-items: center; gap: 8px; padding: 0.65rem 0.85rem; border-radius: 8px; border: 1.5px solid var(--border-subtle); background: var(--bg-elevated); cursor: pointer; user-select: none;">
                  <input type="radio" name="timeline" value="2 to 3 Months" style="accent-color: var(--theme-primary);" />
                  <span style="font-size: 0.84rem; font-weight: 600;">2–3 Months</span>
                </label>
                <label class="tier-pill-radio" style="min-height: 44px; display: flex; align-items: center; gap: 8px; padding: 0.65rem 0.85rem; border-radius: 8px; border: 1.5px solid var(--border-subtle); background: var(--bg-elevated); cursor: pointer; user-select: none;">
                  <input type="radio" name="timeline" value="Flexible" style="accent-color: var(--theme-primary);" />
                  <span style="font-size: 0.84rem; font-weight: 600;">Flexible</span>
                </label>
              </div>
            </div>

            <div style="display: flex; gap: 10px;">
              <button type="button" class="btn btn-outline" id="btnStep3Back" style="flex: 1; min-height: 48px; justify-content: center;">
                ← Back
              </button>
              <button type="button" class="btn btn-primary" id="btnStep3Next" style="flex: 2; min-height: 48px; justify-content: center;">
                <span>Next: Review &amp; Send</span>
                <span class="btn-arrow">→</span>
              </button>
            </div>
          </div>

          <!-- ==============================================================
               STEP 4: REVIEW & DETAILS
               ============================================================== -->
          <div class="enquiry-step-panel" id="enquiryStep4" data-step="4" style="display: none;">
            <h3 style="font-size: 1.25rem; font-weight: 700; margin-bottom: 0.35rem;">Review your enquiry</h3>
            <p style="font-size: 0.88rem; color: var(--text-muted); margin-bottom: 1rem;">Confirm your details and share any notes:</p>

            <!-- Selection Summary Box -->
            <div id="enquiryReviewSummary" style="background: var(--bg-elevated); border: 1px solid var(--border-subtle); border-radius: 10px; padding: 1rem; margin-bottom: 1.25rem; font-size: 0.85rem; line-height: 1.6;">
              <!-- Dynamic summary inserted by JS -->
            </div>

            <div class="floating-group" style="margin-bottom: 1.5rem;">
              <textarea id="step4Message" class="floating-textarea" placeholder=" " rows="3"></textarea>
              <label for="step4Message" class="floating-label">Tell us about your goals, existing links or ideas...</label>
            </div>

            <div style="display: flex; gap: 10px;">
              <button type="button" class="btn btn-outline" id="btnStep4Back" style="flex: 1; min-height: 48px; justify-content: center;">
                ← Back
              </button>
              <button type="button" class="btn btn-primary" id="btnEnquirySubmit" style="flex: 2; min-height: 48px; justify-content: center;">
                <span id="btnEnquirySubmitText">Send Project Enquiry</span>
                <span class="btn-arrow">→</span>
              </button>
            </div>
          </div>
        </form>

        <!-- ====================================================================
             SUCCESS SCREEN (Animated checkmark + WhatsApp pre-fill follow-up)
             ==================================================================== -->
        <div class="enquiry-success-panel" id="enquirySuccessPanel" style="display: none; text-align: center; padding: 2rem 1rem;">
          <div style="width: 64px; height: 64px; border-radius: 50%; background: #10B981; color: #FFFFFF; font-size: 2rem; display: flex; align-items: center; justify-content: center; margin: 0 auto 1.25rem; box-shadow: 0 10px 25px rgba(16, 185, 129, 0.4);">
            ✓
          </div>
          <h3 style="font-size: 1.35rem; font-weight: 800; margin-bottom: 0.5rem;">Thank you! We've received your enquiry.</h3>
          <p style="font-size: 0.9rem; color: var(--text-muted); max-width: 44ch; margin: 0 auto 1.5rem; line-height: 1.6;">
            Our team in Trivandrum will review your project requirements and get in touch within one working day.
          </p>

          <!-- Crucial WhatsApp Pre-filled Lead Button -->
          <div style="background: rgba(37, 211, 102, 0.08); border: 1.5px solid rgba(37, 211, 102, 0.35); border-radius: 12px; padding: 1.25rem; margin-bottom: 1.25rem; text-align: center;">
            <div style="font-weight: 700; font-size: 0.95rem; margin-bottom: 0.35rem;">Want faster priority response?</div>
            <p style="font-size: 0.82rem; color: var(--text-muted); margin-bottom: 0.85rem;">
              Send these exact details directly to our founder's desk on WhatsApp:
            </p>
            <a
              href="#"
              id="whatsappLeadSuccessBtn"
              target="_blank"
              rel="noopener noreferrer"
              class="btn btn-accent"
              style="width: 100%; min-height: 48px; justify-content: center; font-size: 0.95rem; background: #25D366; border-color: #25D366; color: #FFFFFF;"
            >
              <span>Send these details on WhatsApp 💬</span>
            </a>
          </div>

          <button type="button" class="btn btn-outline" onclick="resetEnquiryForm()" style="min-height: 44px; padding: 0.5rem 1.5rem; font-size: 0.84rem;">
            Submit another enquiry
          </button>
        </div>

        <!-- ====================================================================
             NETWORK / SERVER ERROR FALLBACK PANEL (Never lose a lead!)
             ==================================================================== -->
        <div class="enquiry-fallback-panel" id="enquiryFallbackPanel" style="display: none; padding: 1.5rem; background: rgba(225, 29, 46, 0.06); border: 1.5px solid var(--theme-primary); border-radius: 12px; text-align: center;">
          <div style="font-size: 1.75rem; margin-bottom: 0.5rem;">💬</div>
          <h4 style="font-size: 1.15rem; font-weight: 700; margin-bottom: 0.5rem;">Connect Instantly via WhatsApp</h4>
          <p style="font-size: 0.88rem; color: var(--text-muted); margin-bottom: 1rem; line-height: 1.5;">
            We couldn't connect to the server right now, but your lead is safe! Click below to send your details straight to our team on WhatsApp so we can assist immediately:
          </p>
          <a
            href="#"
            id="whatsappLeadFallbackBtn"
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-accent"
            style="width: 100%; min-height: 48px; justify-content: center; background: #25D366; border-color: #25D366; color: #FFFFFF; font-weight: 700;"
          >
            <span>Open WhatsApp with Details →</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
