<!-- SECTION 12: MEGA FOOTER WITH LINK COLUMNS & GIANT OUTLINED "EXPLORE WINGS" -->
<footer class="footer">
  <div class="container">
    <div class="footer-top-grid">
      <div class="footer-brand-col">
        <a href="/" class="brand-logo-link">
          <span class="logo-white-chip">
            <img src="/logo.png" alt="Explore Wings Logo" />
          </span>
          <span class="brand-logo-text">
            <span class="brand-logo-title" style="color:#FFFFFF;"><%= (locals.settings && locals.settings.site_name) || 'Explore Wings' %></span>
            <span class="brand-logo-sub" style="color:var(--theme-accent);">Digital Technologies</span>
          </span>
        </a>
        <p>
          Your complete digital brand, photography, website, and marketing partner in Thiruvananthapuram (Trivandrum), Kerala.
        </p>
        <form class="newsletter-form" onsubmit="event.preventDefault(); this.querySelector('input').value='Subscribed! Thank you.';">
          <input type="email" placeholder="Enter your email for growth tips" required aria-label="Email for newsletter" />
          <button type="submit">Subscribe</button>
        </form>
      </div>

      <div class="footer-col">
        <h5>Services</h5>
        <ul>
          <li><a href="/services#service-websites">Website Design</a></li>
          <li><a href="/services#service-branding">Branding &amp; Logos</a></li>
          <li><a href="/services#service-social">Social Media &amp; Reels</a></li>
          <li><a href="/services#service-production">Photo &amp; Video Shoots</a></li>
          <li><a href="/services#service-marketing">Digital Marketing</a></li>
          <li><a href="/services#service-business-web">Business Websites</a></li>
        </ul>
      </div>

      <div class="footer-col">
        <h5>Industries</h5>
        <ul>
          <li><a href="/services">Resorts &amp; Ayurvedic Spas</a></li>
          <li><a href="/services">Cafes &amp; Restaurants</a></li>
          <li><a href="/services">Education &amp; Study Abroad</a></li>
          <li><a href="/services">Gyms &amp; Fitness Clubs</a></li>
          <li><a href="/services">Food &amp; Retail Brands</a></li>
          <li><a href="/services">Shopping Malls</a></li>
        </ul>
      </div>

      <div class="footer-col">
        <h5>Company</h5>
        <ul>
          <li><a href="/about">About Explore Wings</a></li>
          <li><a href="/pricing">Packages &amp; Pricing</a></li>
          <li><a href="/#trusted-brands">Brands That Trust Us</a></li>
          <li><a href="/contact">Book a Consultation</a></li>
          <li><a href="/admin/login">Admin Dashboard</a></li>
        </ul>
      </div>

      <div class="footer-col">
        <h5>Trivandrum HQ</h5>
        <p style="margin-bottom:0.75rem;">
          <%= (locals.settings && locals.settings.contact_address) || 'Thiruvananthapuram (Trivandrum), Kerala, India' %>
        </p>
        <p>
          <strong style="color:var(--theme-accent);">Phone:</strong> <a href="tel:<%= (locals.settings && locals.settings.contact_phone) || '+919000000000' %>"><%= (locals.settings && locals.settings.contact_phone) || '+91 90000 00000' %></a><br />
          <strong style="color:var(--theme-accent);">Email:</strong> <a href="mailto:<%= (locals.settings && locals.settings.contact_email) || 'hello@explorewings.in' %>"><%= (locals.settings && locals.settings.contact_email) || 'hello@explorewings.in' %></a><br />
          <strong style="color:var(--theme-accent);">Hours:</strong> Mon – Sat, 9:30 AM – 6:30 PM
        </p>
      </div>
    </div>

    <!-- Giant Outlined "EXPLORE WINGS" Watermark (Fills with Theme Color on Hover) -->
    <div class="footer-giant-watermark" aria-hidden="true">EXPLORE WINGS</div>

    <div class="footer-bottom">
      <span>© 2026 Explore Wings Digital Technologies. Crafted in Trivandrum, Kerala, India.</span>
      <div class="social-links-row">
        <a href="https://instagram.com" target="_blank" rel="noopener" class="social-circle-link" aria-label="Instagram">IG</a>
        <a href="https://linkedin.com" target="_blank" rel="noopener" class="social-circle-link" aria-label="LinkedIn">IN</a>
        <a href="https://facebook.com" target="_blank" rel="noopener" class="social-circle-link" aria-label="Facebook">FB</a>
        <a href="https://youtube.com" target="_blank" rel="noopener" class="social-circle-link" aria-label="YouTube">YT</a>
      </div>
    </div>
  </div>
</footer>
