<!-- SECTION 1: ANNOUNCEMENT & TOP UTILITY BAR -->
<div class="top-utility-bar" role="region" aria-label="Announcement and Site Preferences">
  <div class="container top-utility-inner">
    <div class="top-announcement-msg">
      <span class="top-announcement-badge">Trivandrum, Kerala</span>
      <span>Direct Call: <a href="tel:<%= (locals.settings && locals.settings.phone_primary) || '+917510405067' %>" style="color:inherit; font-weight:700; text-decoration:underline;"><%= (locals.settings && locals.settings.phone_primary) || '+91 75104 05067' %></a> / <a href="tel:<%= (locals.settings && locals.settings.phone_secondary) || '+916238976168' %>" style="color:inherit; font-weight:700; text-decoration:underline;"><%= (locals.settings && locals.settings.phone_secondary) || '+91 62389 76168' %></a> • Free 30-Min Strategy Session</span>
    </div>

    <div class="top-controls-cluster">
      <!-- Auto Scroll Button + Speed Selector -->
      <div class="auto-scroll-group" role="group" aria-label="Auto Scroll Controls">
        <button type="button" class="auto-scroll-toggle-btn" aria-pressed="false">
          ▶ Auto scroll
        </button>
        <select class="auto-scroll-speed-select" aria-label="Auto scroll speed">
          <option value="slow">Slow</option>
          <option value="medium" selected>Medium</option>
          <option value="fast">Fast</option>
        </select>
      </div>

      <!-- Red & Green Round Theme Swatches (Red active by default) -->
      <div class="theme-swatch-group" role="group" aria-label="Color Theme Selector">
        <span class="theme-swatch-label">Theme:</span>
        <button
          type="button"
          class="theme-swatch swatch-green"
          data-set-theme="green"
          aria-label="Green Theme"
          title="Switch to Green Theme (#00A36C)"
        ></button>
        <button
          type="button"
          class="theme-swatch swatch-red active"
          data-set-theme="red"
          aria-label="Red Theme"
          title="Switch to Red Theme (#E11D2E)"
        ></button>
      </div>

      <!-- Separate Light / Dark Mode Toggle -->
      <button type="button" class="mode-toggle-btn" aria-label="Toggle Light or Dark Mode">
        <span>☀</span> <span>Light Mode</span>
      </button>
    </div>
  </div>
</div>
