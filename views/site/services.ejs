<%
  const sec = sections || {};
  const heroSec = sec.header || sec.hero || {};
  const ctaSec = sec.cta || {};
%>

<!-- PAGE HERO -->
<section class="page-hero-editorial" aria-label="Services Header">
  <div class="container">
    <div style="max-width: 800px;">
      <span class="stamp-badge">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <polyline points="20 6 9 17 4 12"></polyline>
        </svg>
        <%= heroSec.badge || heroSec.subtitle || 'Capabilities & Deliverables' %>
      </span>
      <h1 class="page-headline" style="margin-top: 16px;">
        <%- heroSec.title || heroSec.headline || 'Digital services focused on real customer inquiries.' %>
      </h1>
      <p class="page-lead" style="margin-top: 16px;">
        <%= heroSec.subtitle || heroSec.lead || 'We take on a small number of businesses each month so we can build thoroughly and answer your phone calls directly. Every project is built without cookie-cutter templates.' %>
      </p>
    </div>
  </div>
</section>

<!-- SERVICES DETAILED LIST -->
<section class="services-detail-section" style="padding: var(--space-2xl) 0;">
  <div class="container" style="display: flex; flex-direction: column; gap: var(--space-2xl);">
    <% if (services && services.length) { %>
      <% services.forEach((svc, index) => { 
        const anchorId = svc.slug || svc.title.toLowerCase().replace(/[^a-z0-9]+/g, '-');
      %>
        <div id="<%= anchorId %>" class="service-detail-block" style="border-bottom: 1px solid var(--border); padding-bottom: var(--space-xl);">
          <div class="service-detail-grid-layout">
            <div class="service-number-col">
              <%= (index + 1).toString().padStart(2, '0') %>
            </div>
            <div class="service-main-col">
              <h2 style="font-size: 2rem; margin-bottom: 12px;"><%= svc.title %></h2>
              <p style="color: var(--text-muted); font-size: 1rem; line-height: 1.6; margin-bottom: 20px;">
                <%= svc.full_desc || svc.short_desc %>
              </p>
              
              <% 
                const svcIncList = (typeof svc.included === 'string' ? svc.included.split('\n') : (svc.included_items || [])).map(s => s.trim()).filter(Boolean);
              %>
              <% if (svcIncList && svcIncList.length) { %>
                <h3 style="font-size: 1rem; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 12px; color: var(--text);">What's included:</h3>
                <ul class="service-features-list" style="margin-bottom: 24px;">
                  <% svcIncList.forEach(item => { %>
                    <li>
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <polyline points="20 6 9 17 4 12"></polyline>
                      </svg>
                      <%= item %>
                    </li>
                  <% }) %>
                </ul>
              <% } %>
              
              <a href="/contact?service=<%= encodeURIComponent(svc.title) %>" class="btn-primary">
                <span>Enquire about <%= svc.title.toLowerCase() %></span>
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <line x1="5" y1="12" x2="19" y2="12"></line>
                  <polyline points="12 5 19 12 12 19"></polyline>
                </svg>
              </a>
            </div>
            
            <div class="service-side-card">
              <strong style="font-size: 0.875rem; text-transform: uppercase; color: var(--text-muted); letter-spacing: 0.05em;">Best suited for:</strong>
              <p style="font-size: 0.9375rem; color: var(--text);">
                Hotels, resorts, healthcare clinics, retail brands, gyms, and service firms seeking credible results in Kerala.
              </p>
              <div style="margin-top: auto; padding-top: 16px; border-top: 1px dashed var(--border); font-size: 0.8125rem; color: var(--text-muted);">
                Dedicated support &bull; Trivandrum based
              </div>
            </div>
          </div>
        </div>
      <% }) %>
    <% } %>
  </div>
</section>

<!-- BOTTOM CTA BAND -->
<section class="cta-editorial-band" style="background: var(--bg-card); border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); padding: var(--space-2xl) 0;">
  <div class="container" style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 24px;">
    <div>
      <span class="stamp-badge"><%= ctaSec.badge || 'Ready to start?' %></span>
      <h2 style="font-size: 1.75rem; margin-top: 8px;"><%= ctaSec.headline || 'Need a custom package for your business?' %></h2>
      <p style="color: var(--text-muted); margin-top: 6px;"><%= ctaSec.sub || 'We can bundle web, brand design, and photography into a single milestone-based proposal.' %></p>
    </div>
    <div>
      <a href="/contact" class="btn-primary">
        <span>Request proposal</span>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="5" y1="12" x2="19" y2="12"></line>
          <polyline points="12 5 19 12 12 19"></polyline>
        </svg>
      </a>
    </div>
  </div>
</section>
